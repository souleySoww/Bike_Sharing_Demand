    {
      "id": 3,
      "type": "timeseries",
      "title": "Mean prediction vs training demand, per model version",
      "description": "Average predicted rentals per bucket, one line per model_version, against the mean cnt of the champion's training data. A new line means the champion changed. A gap that grows means prediction drift. Orange and red mark predictions above 1.5x and 2x the 60% baseline training mean (145 rentals).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dsp-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 220
              },
              {
                "color": "red",
                "value": 290
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_bin('$bucket'::interval, created_at, $__timeFrom()::timestamptz) AS time,\n  COALESCE(model_version, 'unknown') AS metric,\n  avg(prediction) AS value\nFROM predictions\nWHERE $__timeFilter(created_at)\nGROUP BY 1, 2\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeFrom()::timestamptz AS time,\n       baseline_mean AS \"training cnt mean\"\nFROM v_baseline_numeric WHERE feature = 'cnt' AND is_champion\nUNION ALL\nSELECT $__timeTo()::timestamptz, baseline_mean\nFROM v_baseline_numeric WHERE feature = 'cnt' AND is_champion\nORDER BY 1"
        }
      ]
    },
