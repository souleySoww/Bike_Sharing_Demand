          "rawQuery": true,
          "rawSql": "SELECT bucket_start AS time, psi AS \"PSI atemp\"\nFROM feature_psi('atemp', '$bucket', $__timeFrom(), $__timeTo())\nWHERE sample_size >= 30\nORDER BY 1"
        }
      ]
    },
