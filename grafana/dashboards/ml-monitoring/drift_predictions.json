          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_bin('$bucket'::interval, created_at, $__timeFrom()::timestamptz) AS time,\n  stddev_samp(prediction) AS \"prediction std\"\nFROM predictions\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nHAVING count(*) >= 10\nORDER BY 1"
