  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Feature drift: PSI of temp",
      "description": "Population Stability Index of temp per time bucket. PSI (course 5): below 0.1 no action, 0.1 to 0.25 monitor, above 0.25 retrain. Buckets with fewer than 30 rows are hidden because PSI is noise on small samples. Compared with the current champion's training data.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dsp-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT bucket_start AS time, psi AS \"PSI temp\"\nFROM feature_psi('temp', '$bucket', $__timeFrom(), $__timeTo())\nWHERE sample_size >= 30\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
