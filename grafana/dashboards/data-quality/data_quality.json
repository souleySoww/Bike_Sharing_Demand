{
  "id": null,
  "uid": "data-quality",
  "title": "Data Quality",
  "description": "For data engineers: quality of the ingested files over time (invalid rows, criticality, error categories, Great Expectations results).",
  "tags": [
    "bike-sharing",
    "data-quality"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "title": "Data Docs (validation reports)",
      "type": "link",
      "url": "http://localhost:8081",
      "targetBlank": true,
      "icon": "doc"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "custom",
        "query": "5 minutes,15 minutes,1 hour",
        "current": {
          "text": "5 minutes",
          "value": "5 minutes"
        },
        "options": [
          {
            "text": "5 minutes",
            "value": "5 minutes",
            "selected": true
          },
          {
            "text": "15 minutes",
            "value": "15 minutes",
            "selected": false
          },
          {
            "text": "1 hour",
            "value": "1 hour",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Invalid rows per ingested file (%)",
      "description": "One point per ingested file: the share of its rows that failed validation. The colours follow the criticality rules: below 10% low (green), 10 to 50% medium (orange), above 50% high (red). Red points also raise a Data Quality alert.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dsp-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "barAlignment": 0,
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time, invalid_percent AS \"invalid rows %\"\nFROM ingestion_stats\nWHERE $__timeFilter(created_at)\nORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Criticality per ingested file",
      "description": "Criticality of each ingested file over time: none (green), low (yellow), medium (orange), high (red). High means a missing column or more than 50% invalid rows.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dsp-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "none": {
                  "color": "green",
                  "index": 0,
                  "text": "none"
                },
                "low": {
                  "color": "yellow",
                  "index": 1,
                  "text": "low"
                },
                "medium": {
                  "color": "orange",
                  "index": 2,
                  "text": "medium"
                },
                "high": {
                  "color": "red",
                  "index": 3,
                  "text": "high"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": false,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time, criticality AS \"criticality\"\nFROM ingestion_stats\nWHERE $__timeFilter(created_at)\nORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Invalid rows by error category",
      "description": "Rows with errors per bucket, stacked by the 5 categories: completeness (nulls), validity (out of range), consistency (duplicates, holiday and working day together), schema (missing column) and type (not a number). Orange from 1 row, red from 10 rows (a whole ingested file) in one bucket.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dsp-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_bin('$bucket'::interval, created_at, $__timeFrom()::timestamptz) AS time,\n  category AS metric,\n  sum(error_count) AS value\nFROM v_ingestion_errors\nWHERE $__timeFilter(created_at)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Most frequent error types",
      "description": "Error count per detailed error type and bucket. Only types that occurred are drawn, so the highest bars are the top problems of that period. Orange from 1 error, red from 10.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dsp-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 60,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_bin('$bucket'::interval, created_at, $__timeFrom()::timestamptz) AS time,\n  error_type AS metric,\n  sum(error_count) AS value\nFROM v_ingestion_error_types\nWHERE $__timeFilter(created_at)\nGROUP BY 1, 2\nHAVING sum(error_count) > 0\nORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Great Expectations failed expectations per file",
      "description": "Number of Great Expectations checks that failed for each ingested file. 0 is a clean file. Open the Data Docs report (http://localhost:8081) for details. Orange from 1, red from 5.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dsp-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "barAlignment": 0,
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS time,\n       gx_failed_expectations AS \"failed expectations\"\nFROM ingestion_stats\nWHERE $__timeFilter(created_at)\nORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Valid and invalid rows ingested",
      "description": "Rows received per bucket, split into valid rows (sent to good data and predicted) and invalid rows (sent to bad data). Orange from 1 invalid row, red from 10.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "dsp-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "lineWidth": 2,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": false,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "valid rows"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "invalid rows"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "dsp-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_bin('$bucket'::interval, created_at, $__timeFrom()::timestamptz) AS time,\n  sum(valid_rows) AS \"valid rows\",\n  sum(invalid_rows) AS \"invalid rows\"\nFROM ingestion_stats\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    }
  ]
}
